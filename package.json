{
  "name": "nexo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/public/tsconfig.json",
    "build": "node scripts/build-release.ts",
    "bump": "node scripts/bump-version.ts",
    "nexo": "node packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
